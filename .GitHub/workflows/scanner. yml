name: SWILL Security Scanner

on:
  workflow_dispatch:
    inputs:
      target_url:
        description: 'URL для сканирования'
        required: true
        type: string
  schedule:
    - cron: '0 0 * * *'  # Ежедневный запуск
  push:
    branches: [ main ]

jobs:
  security-scan:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        
      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          
      - name: Run Security Scanner
        env:
          TARGET_URL: ${{ github.event.inputs.target_url || 'https://example.com' }}
        run: python scanner.py "$TARGET_URL"
        
      - name: Upload Report
        uses: actions/upload-artifact@v4
        with:
          name: security-report
          path: |
            security_report.txt
            security_report.json
          retention-days: 30
          
      - name: Display Results
        run: |
          echo "=== SECURITY REPORT ==="
          cat security_report.txt
